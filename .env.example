DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=iranapi
MONGODB_USE_MOCK=false
DJANGO_MANAGEMENT_SQLITE_PATH=.django-management.sqlite3
DJANGO_SECURE_SSL_REDIRECT=false
API_ANON_THROTTLE_RATE=600/minute
API_USER_THROTTLE_RATE=1200/minute
# Production hardening: set DJANGO_DEBUG=false, provide a unique DJANGO_SECRET_KEY,
# use HTTPS origins only, and keep secure cookies enabled behind a trusted proxy.
IRANAPI_ENABLE_LEGACY_API_KEYS=false
IRANAPI_AUTO_SEED_SAMPLE_DATA=true
# Keep legacy API keys disabled unless you are migrating old clients. The session
# auth flow is preferred for the first-party dashboard and masks profile keys.
IRANAPI_SOCIAL_GOOGLE_ENABLED=false
IRANAPI_SOCIAL_GOOGLE_AUTH_URL=
IRANAPI_SOCIAL_GITHUB_ENABLED=false
IRANAPI_SOCIAL_GITHUB_AUTH_URL=
IRANAPI_SOCIAL_MICROSOFT_ENABLED=false
IRANAPI_SOCIAL_MICROSOFT_AUTH_URL=
IRANAPI_SOCIAL_LINKEDIN_ENABLED=false
IRANAPI_SOCIAL_LINKEDIN_AUTH_URL=
