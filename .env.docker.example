MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

BACKEND_PORT=8000
FRONTEND_PORT=5173

MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=iranapi
MONGODB_USE_MOCK=false
DJANGO_MANAGEMENT_SQLITE_PATH=/tmp/iranapi-django-management.sqlite3
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-before-production-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=false
API_ANON_THROTTLE_RATE=600/minute
API_USER_THROTTLE_RATE=1200/minute
IRANAPI_ENABLE_LEGACY_API_KEYS=false
IRANAPI_AUTO_SEED_SAMPLE_DATA=false
MONGO_EXPRESS_BASICAUTH=true
MONGO_EXPRESS_USERNAME=iranapi
MONGO_EXPRESS_PASSWORD=replace-this-local-tools-password
IRANAPI_SOCIAL_GOOGLE_ENABLED=false
IRANAPI_SOCIAL_GOOGLE_AUTH_URL=
IRANAPI_SOCIAL_GITHUB_ENABLED=false
IRANAPI_SOCIAL_GITHUB_AUTH_URL=
IRANAPI_SOCIAL_MICROSOFT_ENABLED=false
IRANAPI_SOCIAL_MICROSOFT_AUTH_URL=
IRANAPI_SOCIAL_LINKEDIN_ENABLED=false
IRANAPI_SOCIAL_LINKEDIN_AUTH_URL=

VITE_API_BASE_URL=/api/v1
CHOKIDAR_USEPOLLING=true
